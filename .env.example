# =============================================================================
# AgentForge configuration
# Copy this file to .env and fill in the values you need.
# Never commit a real .env file.
# =============================================================================

# Active LLM provider: mock | deepseek | hkgai
# mock is deterministic, makes no network calls, and is the default for tests/demo.
AGENTFORGE_LLM_PROVIDER=mock

# -----------------------------------------------------------------------------
# DeepSeek (OpenAI-compatible chat completions API)
# -----------------------------------------------------------------------------
# The standard DEEPSEEK_API_KEY variable is also accepted.
AGENTFORGE_DEEPSEEK_API_KEY=
AGENTFORGE_DEEPSEEK_BASE_URL=https://api.deepseek.com
AGENTFORGE_DEEPSEEK_MODEL=deepseek-chat

# -----------------------------------------------------------------------------
# HKGAI (OpenAI-compatible endpoint; confirm base URL and model with the course)
# -----------------------------------------------------------------------------
# The standard HKGAI_API_KEY variable is also accepted.
AGENTFORGE_HKGAI_API_KEY=
AGENTFORGE_HKGAI_BASE_URL=
AGENTFORGE_HKGAI_MODEL=

# -----------------------------------------------------------------------------
# LLM behaviour
# -----------------------------------------------------------------------------
AGENTFORGE_TEMPERATURE=0.2
AGENTFORGE_MAX_TOKENS=2048
AGENTFORGE_REQUEST_TIMEOUT=60
AGENTFORGE_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# Orchestration limits (loops / runaway delegation protection)
# -----------------------------------------------------------------------------
AGENTFORGE_MAX_PLAN_SUBTASKS=8
AGENTFORGE_MAX_DELEGATION_DEPTH=3
AGENTFORGE_MAX_DELEGATION_ROUNDS=2
AGENTFORGE_MAX_EXECUTION_STEPS=30
AGENTFORGE_MAX_TASKS_PER_WORKFLOW=60
AGENTFORGE_MAX_LLM_CALLS_PER_WORKFLOW=200
AGENTFORGE_MAX_TASK_TOKENS=120000
AGENTFORGE_MAX_REPEATED_TOOL_ACTIONS=3
AGENTFORGE_STRUCTURED_OUTPUT_REPAIRS=1
AGENTFORGE_REQUIRE_STRUCTURED_ACTIONS=true
AGENTFORGE_ENABLE_FINAL_REVIEW=true
# Maximum automatic reassignments after a delegated agent rejects a task.
AGENTFORGE_MAX_REASSIGNMENTS=2

# -----------------------------------------------------------------------------
# Human-in-the-loop (Phase 4)
# -----------------------------------------------------------------------------
AGENTFORGE_APPROVAL_TTL_SECONDS=3600
AGENTFORGE_CLARIFICATION_TTL_SECONDS=86400
AGENTFORGE_WORKFLOW_EVENT_LIMIT=1000

# -----------------------------------------------------------------------------
# Tools / private workspaces
# -----------------------------------------------------------------------------
AGENTFORGE_TOOLS_ENABLED=true
AGENTFORGE_MAX_TOOL_CALLS_PER_TASK=6
AGENTFORGE_TOOL_OUTPUT_LIMIT_BYTES=65536
AGENTFORGE_MAX_FILE_BYTES=262144
AGENTFORGE_MAX_WORKSPACE_FILES=200
# Defaults are <data_dir>/workspaces and <data_dir>/artifacts.
# AGENTFORGE_WORKSPACE_ROOT=data/workspaces
# AGENTFORGE_ARTIFACTS_ROOT=data/artifacts

# -----------------------------------------------------------------------------
# Docker sandbox (required for python_execute / python_test / demo-tools)
# -----------------------------------------------------------------------------
AGENTFORGE_SANDBOX_IMAGE=python:3.11-slim
AGENTFORGE_SANDBOX_CPU_LIMIT=1.0
AGENTFORGE_SANDBOX_MEMORY_MB=256
AGENTFORGE_SANDBOX_PIDS_LIMIT=64
AGENTFORGE_SANDBOX_TIMEOUT_SECONDS=30
AGENTFORGE_SANDBOX_OUTPUT_LIMIT_BYTES=65536
AGENTFORGE_SANDBOX_NETWORK_ENABLED=false
AGENTFORGE_SANDBOX_CONTAINER_USER=65534:65534
AGENTFORGE_SANDBOX_READ_ONLY_ROOT=true
AGENTFORGE_SANDBOX_TMPFS_SIZE_MB=64

# -----------------------------------------------------------------------------
# Web search (mock is deterministic and makes no network calls)
# -----------------------------------------------------------------------------
AGENTFORGE_SEARCH_PROVIDER=mock
# Required for provider=http; expected JSON: {"results":[{title,url,snippet,source}]}
# AGENTFORGE_SEARCH_ENDPOINT=https://your-search-service.example/v1/search
# AGENTFORGE_SEARCH_API_KEY=
AGENTFORGE_SEARCH_TIMEOUT=15
AGENTFORGE_SEARCH_MAX_RESULTS=5
AGENTFORGE_WEB_FETCH_MAX_BYTES=262144
AGENTFORGE_WEB_FETCH_MAX_REDIRECTS=3

# -----------------------------------------------------------------------------
# Local Git tools (disabled unless an authorized repository root is configured)
# -----------------------------------------------------------------------------
# AGENTFORGE_GIT_REPO_ROOT=D:/path/to/an/authorized/repo
AGENTFORGE_GIT_TIMEOUT=30

# -----------------------------------------------------------------------------
# Memory evolution (Phase 3)
# -----------------------------------------------------------------------------
AGENTFORGE_MEMORY_EVOLUTION_ENABLED=true
AGENTFORGE_MEMORY_RECALL_ENABLED=true
# Defaults to <data_dir>/memory_evolution.db
# AGENTFORGE_MEMORY_FILE=data/memory_evolution.db
AGENTFORGE_MEMORY_RECALL_LIMIT=6
AGENTFORGE_MEMORY_PROMPT_BUDGET_CHARS=3000
# Mock memories are stored as provisional and never high-confidence.
AGENTFORGE_MEMORY_INCLUDE_MOCK=false
AGENTFORGE_MEMORY_INCLUDE_UNVERIFIED=false
AGENTFORGE_MEMORY_PROMOTION_THRESHOLD=2
AGENTFORGE_MEMORY_PROMOTION_CONFIDENCE=0.8
AGENTFORGE_MEMORY_DECAY_HALF_LIFE_DAYS=30
AGENTFORGE_MEMORY_FORGET_THRESHOLD=0.05
AGENTFORGE_MEMORY_WORKING_TTL_SECONDS=3600
AGENTFORGE_MEMORY_EMBEDDING_DIMENSIONS=256
AGENTFORGE_MEMORY_STORE_MOCK_PROCEDURES=true

# -----------------------------------------------------------------------------
# Persistence and observability
# -----------------------------------------------------------------------------
AGENTFORGE_DATA_DIR=data
AGENTFORGE_LOG_LEVEL=INFO
# Optional. Defaults to <data_dir>/events.jsonl and <data_dir>/agentforge.db.
# AGENTFORGE_EVENTS_FILE=data/events.jsonl
# AGENTFORGE_SQLITE_FILE=data/agentforge.db
# AGENTFORGE_LOG_FILE=data/agentforge.log

# Deterministic mock latency (milliseconds) for UI / testing the async path.
AGENTFORGE_MOCK_LATENCY_MS=0

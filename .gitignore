# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Environment / secrets
.env
.env.*
!.env.example

# Runtime data (SQLite, JSONL logs, workspaces, artifacts, generated reports)
data/*
!data/.gitkeep

# Benchmark artefacts: keep compact reports/JSON/CSV, ignore workspaces and DBs
benchmarks/runs/**/task_runs/
benchmarks/runs/**/runs/
benchmarks/runs/**/workspaces/
benchmarks/runs/**/artifacts/
benchmarks/runs/**/*.db
benchmarks/runs/**/*.db-*
benchmarks/runs/**/events.jsonl

# Test / tooling caches
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
